{
  "name": "gatsby-starter-default",
  "private": true,
  "description": "A simple starter to get up and developing quickly with Gatsby",
  "version": "0.1.0",
  "author": "Kyle Mathews <mathews.kyle@gmail.com>",
  "dependencies": {
    "gatsby": "^2.21.22",
    "gatsby-image": "^2.4.3",
    "gatsby-plugin-manifest": "^2.4.2",
    "gatsby-plugin-offline": "^3.2.1",
    "gatsby-plugin-react-helmet": "^3.3.1",
    "gatsby-plugin-sharp": "^2.6.2",
    "gatsby-source-filesystem": "^2.3.1",
    "gatsby-transformer-sharp": "^2.5.2",
    "luxon": "^3.6.1",
    "moment": "^2.30.1",
    "prop-types": "^15.7.2",
    "react": "^16.12.0",
    "react-countdown": "^2.3.6",
    "react-dom": "^16.12.0",
    "react-helmet": "^6.0.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/react": "^16.12.0",
    "@types/react-dom": "^16.12.0",
    "babel-jest": "^26.0.1",
    "babel-preset-gatsby": "^0.4.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^26.0.1",
    "prettier": "2.0.5",
    "react-test-renderer": "^16.13.1"
  },
  "keywords": [
    "gatsby",
    "gitlab pages",
    "react"
  ],
  "license": "MIT",
  "scripts": {
    "gatsby": "export NODE_OPTIONS=--openssl-legacy-provider || set NODE_OPTIONS=--openssl-legacy-provider && gatsby",
    "build": "yarn run gatsby build",
    "serve": "yarn run gatsby serve",
    "develop": "yarn run gatsby develop",
    "start": "yarn run gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "clean": "yarn run gatsby clean",
    "test:unit": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-default"
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  }
}
